model Cohort {
  id      String   @id
  name    String
  players Player[]
}

model Player {
  id           String      @id // wallet address
  name         String
  avatar       String      @default("builder-1")
  xp           Int         @default(0)
  points       Int         @default(0)
  cohortId     String?
  cohort       Cohort?     @relation(fields: [cohortId], references: [id])
  createdAt    DateTime    @default(now())
  lastActiveAt DateTime    @default(now())
  progress     Progress[]
  badges       Badge[]
  sporeMint    SporeMint?
}

